# Simplified wind-tunnel body with a roof step that drives a separated wake.
# x is streamwise, y is spanwise, and z is vertical.
box -1.5 -0.6 -0.5 3.0 1.2 0.65
attribute groupName $body
store $lowerBody

box -0.8 -0.6 0.15 1.3 1.2 0.55
attribute groupName $body
store $upperBody

restore $lowerBody
restore $upperBody
union
attribute groupName $body
end
