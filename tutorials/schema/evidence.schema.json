{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-flow360.local/schemas/evidence.schema.json",
  "title": "Vibe Flow360 Tutorial Evidence Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "criteria", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "description", "artifact", "required", "check"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "category": {"enum": ["mesh", "convergence", "conservation", "force", "field", "report", "provenance"]},
          "description": {"type": "string", "minLength": 1},
          "artifact": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "metric"],
            "properties": {
              "method": {"enum": ["less_than", "less_equal", "greater_than", "greater_equal", "between", "relative_change", "present", "manual"]},
              "metric": {"type": "string", "minLength": 1},
              "value": {},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"},
              "tolerance": {"type": "number", "minimum": 0},
              "unit": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
