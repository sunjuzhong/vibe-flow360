{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-flow360.local/schemas/validation-report.schema.json",
  "title": "Vibe Flow360 Tutorial Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "api_version", "package_version", "registry_sha256", "tutorials"],
  "properties": {
    "report_version": {"const": 1},
    "api_version": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "minLength": 1},
    "registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tutorials": {
      "type": "object",
      "propertyNames": {"pattern": "^T[0-9]{2}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest", "status", "artifacts", "coverage", "warnings", "errors"],
        "properties": {
          "manifest": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "checks"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "coverage": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
          "warnings": {"type": "array"},
          "errors": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
