# Agent provider: builtin (default) or codex.
VIBESIM_AGENT_PROVIDER=builtin

# Built-in provider. Without an API key it uses the deterministic local CFD
# planner and never contacts an AI provider.
VIBESIM_AI_API_KEY=
VIBESIM_AI_BASE_URL=https://api.openai.com/v1
VIBESIM_AI_MODEL=gpt-4.1-mini

# External Codex provider. Used only when VIBESIM_AGENT_PROVIDER=codex.
# Codex authentication comes from the normal Codex CLI environment.
VIBESIM_CODEX_BINARY=codex
VIBESIM_CODEX_MODEL=
VIBESIM_CODEX_PROFILE=
VIBESIM_CODEX_TIMEOUT_SECONDS=300

# Exact CAD runtime used by AI Create. vibe-flow360 init preloads CadQuery 2.6.1.
# Leave blank for deterministic discovery beside the app, in ~/.local/bin,
# standard package-manager locations, and the service PATH. Set an absolute
# path only when uv is installed elsewhere.
VIBESIM_UV_BINARY=
VIBESIM_UV_CACHE_DIR=
VIBESIM_UV_PYTHON_INSTALL_DIR=
VIBESIM_CAD_PYTHON=3.11
VIBESIM_CAD_TIMEOUT_SECONDS=90
VIBESIM_CAD_OFFLINE=false

# Flow360 CLI connection.
#
# Leave FLOW360_APIKEY empty when the key has already been stored with:
#   flow360 login --profile default
# or:
#   flow360 configure --apikey ... --profile default
#
# FLOW360_APIKEY is the environment variable natively supported by Flow360.
FLOW360_APIKEY=
VIBESIM_FLOW360_PROFILE=default

# Empty means the normal production environment.
# Other supported values: dev, uat, or a named environment passed to --env.
VIBESIM_FLOW360_ENV=

# Written automatically by `vibe-flow360 init`. An absolute path keeps
# background services independent of shell PATH and Python environments.
VIBESIM_FLOW360_BINARY=

# Local durable state for reviewed plans and recovery metadata.
# Relative paths are resolved from the directory where VibeSim is started.
VIBESIM_DATA_DIR=.vibesim

# Time-series Slice/Surface archives and converted frames are isolated by
# Flow360 environment/profile. Defaults: 250 GiB total cache, 30-day retention.
VIBESIM_SLICE_PLAYER_CACHE_MAX_BYTES=268435456000
VIBESIM_SLICE_PLAYER_CACHE_RETENTION_HOURS=720
